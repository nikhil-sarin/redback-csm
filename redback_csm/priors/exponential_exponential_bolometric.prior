mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\mathrm{exp}}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\mathrm{exp}}~({\\mathrm{foe}})$')
mexp_out = LogUniform(minimum=1, maximum=30, name='mexp_out', latex_label='$M_{\\mathrm{exp,out}}~(M_\\odot)$')
eexp_out = LogUniform(minimum=0.1, maximum=10, name='eexp_out', latex_label='$E_{\\mathrm{exp,out}}~({\\mathrm{foe}})$')
interval = LogUniform(minimum=1, maximum=10000, name='interval', latex_label='$\\Delta{}t~({\\mathrm{days}})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
