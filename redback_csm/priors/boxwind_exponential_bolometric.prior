t1 = LogUniform(minimum=0.01, maximum=100, name='t1', latex_label='$t_1~({\\mathrm{yr}})$')
t2 = LogUniform(minimum=0.01, maximum=1000, name='t2', latex_label='$t_2~({\\mathrm{yr}})$')
mdot_0 = LogUniform(minimum=1e-6, maximum=100, name='mdot_0', latex_label='$\\dot{M}_0$')
mdot_1 = LogUniform(minimum=1e-6, maximum=100, name='mdot_1', latex_label='$\\dot{M}_1$')
mdot_2 = LogUniform(minimum=1e-6, maximum=100, name='mdot_2', latex_label='$\\dot{M}_2$')
vwind = LogUniform(minimum=10, maximum=1000, name='vwind', latex_label='$v_{\\mathrm{wind}}~({\\mathrm{km/s}})$')
mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\mathrm{exp}}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\mathrm{exp}}~({\\mathrm{foe}})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
