base_density = LogUniform(minimum=1e-20, maximum=1e-12, name='base_density', latex_label='$\\rho_{\\mathrm{base}}$')
base_index = Uniform(minimum=-4, maximum=0, name='base_index', latex_label='$s$')
interval_sn = LogUniform(minimum=1, maximum=10000, name='interval_sn', latex_label='$\\Delta{}t_{\\mathrm{SN}}~({\\mathrm{days}})$')
delta_sn = Uniform(minimum=0, maximum=2, name='delta_sn', latex_label='$\\delta_{\\mathrm{SN}}$')
nn_sn = Uniform(minimum=6, maximum=14, name='nn_sn', latex_label='$n_{\\mathrm{SN}}$')
mej_sn = LogUniform(minimum=1, maximum=30, name='mej_sn', latex_label='$M_{\\mathrm{ej,SN}}~(M_\\odot)$')
esn = LogUniform(minimum=0.1, maximum=10, name='esn', latex_label='$E_{\\mathrm{SN}}~({\\mathrm{foe}})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
shell1_radius = LogUniform(minimum=1e13, maximum=1e17, name='shell1_radius', latex_label='$r_1~({\\mathrm{cm}})$')
shell1_width = LogUniform(minimum=1e12, maximum=1e16, name='shell1_width', latex_label='$w_1~({\\mathrm{cm}})$')
shell1_density = LogUniform(minimum=1e-20, maximum=1e-12, name='shell1_density', latex_label='$\\rho_1$')
shell2_radius = LogUniform(minimum=1e13, maximum=1e17, name='shell2_radius', latex_label='$r_2~({\\mathrm{cm}})$')
shell2_width = LogUniform(minimum=1e12, maximum=1e16, name='shell2_width', latex_label='$w_2~({\\mathrm{cm}})$')
shell2_density = LogUniform(minimum=1e-20, maximum=1e-12, name='shell2_density', latex_label='$\\rho_2$')
shell3_radius = LogUniform(minimum=1e13, maximum=1e17, name='shell3_radius', latex_label='$r_3~({\\mathrm{cm}})$')
shell3_width = LogUniform(minimum=1e12, maximum=1e16, name='shell3_width', latex_label='$w_3~({\\mathrm{cm}})$')
shell3_density = LogUniform(minimum=1e-20, maximum=1e-12, name='shell3_density', latex_label='$\\rho_3$')
shell4_radius = LogUniform(minimum=1e13, maximum=1e17, name='shell4_radius', latex_label='$r_4~({\\mathrm{cm}})$')
shell4_width = LogUniform(minimum=1e12, maximum=1e16, name='shell4_width', latex_label='$w_4~({\\mathrm{cm}})$')
shell4_density = LogUniform(minimum=1e-20, maximum=1e-12, name='shell4_density', latex_label='$\\rho_4$')
f_nickel = LogUniform(minimum=1e-3, maximum=1, name='f_nickel', latex_label='$f_{\\mathrm{Ni}}$')
mej = LogUniform(minimum=0.1, maximum=30, name='mej', latex_label='$M_{\\mathrm{ej}}~(M_\\odot)$')
kappa = Uniform(minimum=0.05, maximum=2, name='kappa', latex_label='$\\kappa~({\\mathrm{cm}}^2/{\\mathrm{g}})$')
kappa_gamma = LogUniform(minimum=1e-4, maximum=1e4, name='kappa_gamma', latex_label='$\\kappa_\\gamma$')
vej = LogUniform(minimum=1e3, maximum=3e4, name='vej', latex_label='$v_{\\mathrm{ej}}~({\\mathrm{km/s}})$')
