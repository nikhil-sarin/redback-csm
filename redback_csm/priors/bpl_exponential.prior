redshift = Uniform(minimum=1e-3, maximum=3, name='redshift', latex_label='$z$')
delta = Uniform(minimum=0, maximum=2, name='delta', latex_label='$\\delta$')
nn = Uniform(minimum=6, maximum=14, name='nn', latex_label='$n$')
mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\rm exp}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\rm exp}~({\\rm foe})$')
mexp_out = LogUniform(minimum=1, maximum=30, name='mexp_out', latex_label='$M_{\\rm exp,out}~(M_\\odot)$')
eexp_out = LogUniform(minimum=0.1, maximum=10, name='eexp_out', latex_label='$E_{\\rm exp,out}~({\\rm foe})$')
interval = LogUniform(minimum=1, maximum=10000, name='interval', latex_label='$\\Delta t~({\\rm days})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
temperature_floor = LogUniform(minimum=100, maximum=1e4, name='temperature_floor', latex_label='$T_{\\rm floor}~({\\rm K})$')
