mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\mathrm{exp}}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\mathrm{exp}}~({\\mathrm{foe}})$')
t_break1 = LogUniform(minimum=0.1, maximum=100, name='t_break1', latex_label='$t_{\\mathrm{break,1}}~({\\mathrm{yr}})$')
t_break2 = LogUniform(minimum=0.1, maximum=1000, name='t_break2', latex_label='$t_{\\mathrm{break,2}}~({\\mathrm{yr}})$')
mdot_0 = LogUniform(minimum=1e-6, maximum=10, name='mdot_0', latex_label='$\\dot{M}_0$')
alpha1 = Uniform(minimum=-5, maximum=5, name='alpha1', latex_label='$\\alpha_1$')
alpha2 = Uniform(minimum=-5, maximum=5, name='alpha2', latex_label='$\\alpha_2$')
alpha3 = Uniform(minimum=-5, maximum=5, name='alpha3', latex_label='$\\alpha_3$')
vwind = LogUniform(minimum=10, maximum=1000, name='vwind', latex_label='$v_{\\mathrm{wind}}~({\\mathrm{km/s}})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
