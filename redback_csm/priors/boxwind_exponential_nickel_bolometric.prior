t1 = LogUniform(minimum=0.01, maximum=100, name='t1', latex_label='$t_1~({\\rm yr})$')
t2 = LogUniform(minimum=0.01, maximum=1000, name='t2', latex_label='$t_2~({\\rm yr})$')
mdot_0 = LogUniform(minimum=1e-6, maximum=100, name='mdot_0', latex_label='$\\dot{M}_0$')
mdot_1 = LogUniform(minimum=1e-6, maximum=100, name='mdot_1', latex_label='$\\dot{M}_1$')
mdot_2 = LogUniform(minimum=1e-6, maximum=100, name='mdot_2', latex_label='$\\dot{M}_2$')
vwind = LogUniform(minimum=10, maximum=1000, name='vwind', latex_label='$v_{\\rm wind}~({\\rm km/s})$')
mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\rm exp}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\rm exp}~({\\rm foe})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
f_nickel = LogUniform(minimum=1e-3, maximum=1, name='f_nickel', latex_label='$f_{\\rm Ni}$')
mej = LogUniform(minimum=0.1, maximum=30, name='mej', latex_label='$M_{\\rm ej}~(M_\\odot)$')
kappa = Uniform(minimum=0.05, maximum=2, name='kappa', latex_label='$\\kappa~({\\rm cm}^2/{\\rm g})$')
kappa_gamma = LogUniform(minimum=1e-4, maximum=1e4, name='kappa_gamma', latex_label='$\\kappa_\\gamma$')
vej = LogUniform(minimum=1e3, maximum=3e4, name='vej', latex_label='$v_{\\rm ej}~({\\rm km/s})$')
