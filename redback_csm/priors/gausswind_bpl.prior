redshift = Uniform(minimum=1e-3, maximum=3, name='redshift', latex_label='$z$')
t_peak = LogUniform(minimum=1, maximum=100, name='t_peak', latex_label='$t_{\\mathrm{peak}}~({\\mathrm{yr}})$')
t_width = LogUniform(minimum=0.1, maximum=50, name='t_width', latex_label='$\\sigma_t~({\\mathrm{yr}})$')
mdot_baseline = LogUniform(minimum=1e-6, maximum=1, name='mdot_baseline', latex_label='$\\dot{M}_{\\mathrm{base}}$')
mdot_peak = LogUniform(minimum=1e-6, maximum=10, name='mdot_peak', latex_label='$\\dot{M}_{\\mathrm{peak}}$')
vwind = LogUniform(minimum=10, maximum=1000, name='vwind', latex_label='$v_{\\mathrm{wind}}~({\\mathrm{km/s}})$')
delta = Uniform(minimum=0, maximum=2, name='delta', latex_label='$\\delta$')
nn = Uniform(minimum=6, maximum=14, name='nn', latex_label='$n$')
mexp = LogUniform(minimum=1, maximum=30, name='mexp', latex_label='$M_{\\mathrm{exp}}~(M_\\odot)$')
eexp = LogUniform(minimum=0.1, maximum=10, name='eexp', latex_label='$E_{\\mathrm{exp}}~({\\mathrm{foe}})$')
eff = Uniform(minimum=0.01, maximum=1, name='eff', latex_label='$\\epsilon$')
temperature_floor = LogUniform(minimum=100, maximum=1e4, name='temperature_floor', latex_label='$T_{\\mathrm{floor}}~({\\mathrm{K}})$')
